# Copie para .env e preencha localmente. Nunca commitar o .env real.

# Qual fonte de ofertas usar (ver app/config.py). Padrão: mercadolivre
# (scraping, não exige credencial nenhuma).
# OFFER_SOURCE=mercadolivre

# Opcional — intervalo mínimo (segundos) entre buscas no Mercado Livre via
# scraping. Scraping com navegador é mais pesado que uma chamada de API,
# por isso o padrão (2.0s) é maior que o da Shopee.
# MERCADOLIVRE_MIN_INTERVAL_SECONDS=2.0

# Opcional — desconto mínimo (%) pra um produto aparecer na revisão manual
# (ver app/filtro.py). Também dá pra mudar por busca, sem editar nada, com
# ?desconto_min=50 na URL da dashboard. Padrão: 30.
# DESCONTO_MINIMO_PERCENTUAL=30

# Credenciais da Shopee Affiliate Open API — só existem depois de virar
# afiliado aprovado e pedir liberação de API no painel de afiliado.
# Ver docs/decisao-fonte-de-dados.md.
# SHOPEE_APP_ID=
# SHOPEE_APP_SECRET=

# Opcional — intervalo mínimo (segundos) entre chamadas à Shopee, pra
# respeitar rate limit sem precisar de infraestrutura extra no MVP.
# SHOPEE_MIN_INTERVAL_SECONDS=1.0

# Preenchido quando a etapa de banco de dados existir
# DATABASE_URL=postgresql://user:password@localhost:5432/grupo_de_ofertas

# Telegram (telegram_envio.py). TELEGRAM_BOT_TOKEN vem do @BotFather (/newbot); o bot precisa ser
# administrador do grupo/canal. TELEGRAM_CHAT_ID: mande uma mensagem no grupo e rode
# .venv\Scripts\python.exe telegram_envio.py descobrir-chat
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Painel online compartilhado (envio pelo botão "Enviar ao painel" do painel local).
# PAINEL_URL é o endereço do painel online, SEMPRE com https:// (só localhost pode ser http).
# PAINEL_TOKEN você gera no painel online, em "Meus tokens". É segredo: nunca commitar o .env real.
# PAINEL_URL=https://painel.seudominio.com
# PAINEL_TOKEN=td_cole_aqui_o_token_gerado
